# Google Calendar. "primary" is your main Google Calendar.
GOOGLE_CALENDAR_ID=primary

# How often to check for new/rescheduled games.
SYNC_INTERVAL_MINUTES=360

# Import games this far into the future.
LOOKAHEAD_DAYS=400

# Default game duration used for calendar end time.
GAME_DURATION_MINUTES=150

# Europe/Athens keeps tipoff times correct for you.
TIMEZONE=Europe/Athens

# Paths relative to the project root.
DB_PATH=data/sync.db
GOOGLE_CREDENTIALS=credentials/credentials.json
GOOGLE_TOKEN=credentials/token.json
